ARG BASE_IMAGE=local/superset-native-ai:master-db556ec6-base
FROM ${BASE_IMAGE}

ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/apache/superset" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.title="Superset master with preserved Native AI"

USER root

# Assets are built from the same integration checkout with bounded CPU usage.
COPY --from=compiled-static --chown=superset:superset /assets/ /app/superset/static/assets/
COPY --from=compiled-static --chown=superset:superset /service-worker.js /app/superset/static/service-worker.js

# Use the upstream dependency bounds and retain this deployment's telemetry.
RUN uv pip install --no-cache-dir \
    -e ".[fastmcp,ai-openai,postgres,mssql]" "langfuse==4.14.4"

USER superset
